# Copy this file to .env and fill in your keys.

# Required for the chatbot to talk. Without it, the ML + research still work,
# but the bot can't generate replies.
ANTHROPIC_API_KEY=

# Which Claude model powers the chat. Opus is the smartest; if you're watching
# cost, swap to claude-sonnet-5 (cheaper, still very good).
ANTHROPIC_MODEL=claude-opus-4-8

# Optional: outside research from social media / the web (Reddit, forums, etc.)
# Get a key at https://exa.ai . If blank, web research is skipped.
EXA_API_KEY=

# OpenAlex (academic papers on relationship psychology) needs no key, but it's
# polite to identify yourself. Put any email here.
OPENALEX_MAILTO=you@example.com
