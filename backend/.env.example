# Copy this file to .env and fill in what you need.
# Everything here is a DEFAULT — most of it can also be set per-account in the
# in-app Settings page, which takes precedence.

# ---- Chat (needed for the bot to reply) ---------------------------------
# You can instead paste this in Settings once the app is running.
ANTHROPIC_API_KEY=
# The model. Opus 4.8 is the smartest and the default.
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Research (optional) ------------------------------------------------
# Social / Reddit research. Key from https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Academic (OpenAlex) needs no key — just an email to be polite.
OPENALEX_MAILTO=you@example.com

# ---- Sessions -----------------------------------------------------------
# Signs the login cookie. Set to a long random string in production
# (e.g. `python -c "import secrets;print(secrets.token_hex(32))"`).
SECRET_KEY=

# ---- Google Sign-In (optional — enables permanent, per-account memory) --
# Leave blank to run in single-user "local mode" (no login required).
# Create credentials at https://console.cloud.google.com/apis/credentials
#   -> OAuth client ID -> Web application
#   -> Authorized redirect URI: https://YOUR-APP.up.railway.app/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---- Storage ------------------------------------------------------------
# Two options for permanent storage:
#
# A) Postgres (recommended on Railway): add a Postgres database in Railway and
#    it provides DATABASE_URL automatically. If DATABASE_URL is set, the app
#    uses Postgres and you do NOT need a volume.
DATABASE_URL=
#
# B) SQLite on a mounted Railway Volume: leave DATABASE_URL blank and point
#    this at the volume mount, e.g. GIRLBOT_DATA_DIR=/data . Locally, leave
#    both blank and it uses a local SQLite file.
GIRLBOT_DATA_DIR=
